# Supabase Cloud-Projekt: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-Role-Key wird serverseitig genutzt (lesender und schreibender Zugriff,
# da single-user und Auth via Passwort statt Supabase-Auth abgewickelt wird).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Passwort für den Zugang zur App (single-user)
APP_PASSWORD=changeme

# Geheimer Schlüssel für signierte Auth-Cookies (irgendein langer Random-String)
AUTH_SECRET=please-change-me-to-a-long-random-string

# Anthropic API-Key für den "Rezept aus Text einlesen"-Parser.
# Optional: ohne Key ist der Import-Knopf inaktiv, alles andere funktioniert.
# Holst du dir auf https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
